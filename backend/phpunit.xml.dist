<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         executionOrder="random"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="api">
            <directory>tests/Api</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <env name="APP_DEBUG" value="1" force="true"/>
        <env name="DB_NAME" value="products_test" force="true"/>
        <env name="JWT_SECRET" value="test-secret-test-secret-test-secret" force="true"/>
        <env name="JWT_TTL" value="3600" force="true"/>
        <env name="MESSENGER_TRANSPORT_DSN" value="in-memory://" force="true"/>
        <env name="IMPORT_RATE_LIMIT" value="5" force="true"/>
        <env name="IMPORT_RATE_INTERVAL" value="1 minute" force="true"/>
    </php>
</phpunit>
