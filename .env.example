# 1 — показывать детали ошибок в ответах API, только для разработки
APP_DEBUG=0
# Порт на хосте, на котором nginx отдаёт приложение
APP_PORT=8080

# Подключение к PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_NAME=products
DB_USER=app
DB_PASSWORD=app

# Учётная запись RabbitMQ и порт веб-интерфейса на хосте
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app
RABBITMQ_UI_PORT=15672
# Транспорт очереди импорта для Symfony Messenger
MESSENGER_TRANSPORT_DSN=amqp://app:app@rabbitmq:5672/%2f/imports

# Минимальный уровень логов: debug, info, warning, error
LOG_LEVEL=info

# Секрет для подписи JWT, не короче 32 символов. make init сгенерирует его сам
JWT_SECRET=
# Время жизни токена в секундах
JWT_TTL=3600

# Администратор, которого создают сиды (make seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Скачивание изображений при импорте: таймаут в секундах, максимальный размер файла в байтах
# и число одновременных запросов к одному хосту
IMAGE_DOWNLOAD_TIMEOUT=15
IMAGE_MAX_SIZE=10485760
IMAGE_DOWNLOAD_CONCURRENCY=6
